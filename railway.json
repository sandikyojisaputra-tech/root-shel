{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node server.ts",
    "restartPolicyMaxRetries": 3,
    "restartPolicyWindowSeconds": 60,
    "healthchecks": {
      "liveness": {
        "initialDelaySeconds": 10,
        "periodSeconds": 10,
        "timeoutSeconds": 5,
        "failureThreshold": 3
      },
      "readiness": {
        "initialDelaySeconds": 5,
        "periodSeconds": 5,
        "timeoutSeconds": 3,
        "failureThreshold": 2
      }
    }
  },
  "variables": {
    "NODE_ENV": "production",
    "HOST": "0.0.0.0"
  }
}
