# Pterodactyl Server Management Panel - Environment Configuration

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Server Status (default: running)
# Values: running, offline
SERVER_STATUS=running

# Docker Configuration
DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:node_20
STARTUP_COMMAND=npm start

# Auto-execute startup command when server starts
AUTO_EXECUTE_STARTUP=true

# Real-time Monitoring (in milliseconds)
MONITORING_INTERVAL=1000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_PING_TIMEOUT=5000

# Logging
LOG_LEVEL=info
LOG_FILE=audit-logs.json

# Railway Specific
RAILWAY_ENVIRONMENT_NAME=production
RAILWAY_SERVICE_NAME=pterodactyl-panel

# Security (optional)
# AUTH_TOKEN=your_secret_token_here
